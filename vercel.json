{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://ffbb-api.desimone.fr/api/v1/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://scba-benevole.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
