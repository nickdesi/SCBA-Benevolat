rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper pour vérifier si l'utilisateur est admin
    // Utilise les Custom Claims définis par la Cloud Function 'setAdminRole'
    function isAdmin() {
      // Source de vérité : custom claim 'admin' défini par la Cloud Function setAdminRole/setAdminClaim.
      // Fallback historique sur l'adresse admin existante, conservé pour les comptes actuels.
      return request.auth != null && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        request.auth.token.email == 'benevole@scba.fr'
      );
    }

    // Fonction pour vérifier si l'utilisateur est connecté
    function isAuth() {
      return request.auth != null;
    }

    function isSafeParticipantUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAuth() &&
        changed.hasOnly(['roles', 'carpool']) &&
        (
          !changed.hasAny(['roles']) ||
          (request.resource.data.roles is list && request.resource.data.roles.size() <= 100)
        ) &&
        (
          !changed.hasAny(['carpool']) ||
          (request.resource.data.carpool is list && request.resource.data.carpool.size() <= 200)
        );
    }

    // Annonces : Lecture publique, Écriture Admin seulement
    // EXCEPTION: Suppression autorisée pour annonces expirées (cleanup automatique)
    match /announcements/{announcement} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() ||
                      (resource.data.expiresAt != null && resource.data.expiresAt < request.time);
    }

    // Matchs :
    // - Lecture publique (tout le monde doit voir les matchs)
    // - Création/Suppression : Admin seulement
    // - Mise à jour : Admin ou Utilisateur connecté (pour s'inscrire/désinscrire)
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Les utilisateurs peuvent modifier uniquement les tableaux de participation.
      // Les données administratives du match restent réservées aux administrateurs.
      allow update: if isAdmin() || isSafeParticipantUpdate();
    }

    // Données Utilisateurs (Inscriptions, Profil...)
    // - Lecture : tout utilisateur authentifié (pour afficher les avatars/prénoms
    //   des bénévoles sur le planning) OU Admin.
    // - Écriture : propriétaire du compte OU Admin.
    match /users/{userId}/{document=**} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == userId || isAdmin());
    }
  }
}
